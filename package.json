{
  "name": "recipe-book-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Rezepte-App fürs Heimnetz: Svelte-SPA und Hono-Server mit SQLite",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/main.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/size-check.ts",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.client.json --fail-on-warnings && tsc -p tsconfig.server.json && tsc -p tsconfig.shared.json && tsc -p tsconfig.e2e.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "size": "node scripts/size-check.ts",
    "seed": "node --disable-warning=ExperimentalWarning tests/seed.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.8",
    "qrcode-generator": "2.0.4",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
