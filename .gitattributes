# LF everywhere: Biome checks line endings, and the CSP hash of the inline script in
# client/index.html must match what browsers hash (they normalize CRLF to LF).
* text=auto eol=lf

# PowerShell scripts keep CRLF for Windows editors; PowerShell 5.1 reads both.
*.ps1 text eol=crlf

*.png binary
*.webp binary
*.woff2 binary
*.ico binary
*.sqlite binary
